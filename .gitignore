# ============================================================
# TachyOne_SLM — .gitignore
#
# Specs, docs and configs ARE versioned. Model weights, datasets,
# caches and build artifacts are NOT.
# Intentionally NOT ignored: docs/, *.md, *.yml/*.yaml, mkdocs.yml,
# training/configs/*.json, training/configs/*.yaml, .specs/
# ============================================================

# --- Compiled / binary artifacts ---
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.pyc
*.pyd
__pycache__/

# --- Harness tooling (OpenCode) — not part of the product ---
.opencode/

# --- Python environments & packaging ---
.venv/
venv/
env/
.env
*.egg-info/
dist/
build/

# --- Test / lint / type-check caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
htmlcov/
.coverage
.coverage.*

# --- Documentation builds (mkdocs) ---
site/
site-build/

# --- ML artifacts: model weights & checkpoints are NOT versioned ---
# (regenerated by training/export; release artifacts belong to a registry,
#  never to git — a single 0.5B bf16 checkpoint already exceeds 1 GB)
models/
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
*.onnx
runs/
wandb/
outputs/
checkpoints/

# --- Datasets: raw/large data is regenerated by training/generate_data.py ---
# (Tachyone-SLM-Mixture-v1 ≈ 50k records; configs ARE versioned, data is not)
data/raw/
*.parquet
*.arrow

# --- IDEs / OS ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# ============================================================
# Intentionally versioned (do NOT add to this file):
#   docs/**  *.md  .specs/**     documentation & specs
#   mkdocs.yml  *.yaml           documentation & training configs
#   training/configs/*.json      data/training configs (reproducibility)
#   benchmarks/report.md         published measurement evidence
# ============================================================
